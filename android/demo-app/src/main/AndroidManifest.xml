<?xml version="1.0" encoding="utf-8"?>
<!--
    IrisLensSDK Android - Demo App Manifest

    데모 애플리케이션 매니페스트
    - 카메라 권한 및 기능 선언
    - 액티비티 설정

    @version 1.0.0
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        필수 기능 선언
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- OpenGL ES 3.0 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!--
        권한 선언
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        앱 설정
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IrisLensSDKDemo">

        <!--
            GPU 뷰티 렌더링 액티비티 (메인)

            screenOrientation은 매니페스트에서 고정하지 않고 런타임에 결정한다
            (bool/allow_landscape: 폰=세로 고정, sw600dp 태블릿=가로 허용).
            리소스 한정자가 매니페스트 속성에는 적용되지 않기 때문.

            configChanges는 반드시 유지 — 회전마다 액티비티가 재생성되면 EGL 컨텍스트/
            CameraX 재바인딩/렌즈 썸네일 재디코딩이 일어나고, onSaveInstanceState가 없어
            슬라이더·렌즈 선택·벤치 플래그가 전부 초기화된다.
        -->
        <activity
            android:name=".GpuRenderActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:hardwareAccelerated="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MediaPipe 벤치마크 액티비티 -->
        <activity
            android:name=".MediaPipeBenchmarkActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

    </application>

</manifest>
