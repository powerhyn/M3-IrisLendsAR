<?xml version="1.0" encoding="utf-8"?>
<!--
    IrisLensSDK Android - GPU Render Activity Layout

    Tab 기반 UI: 렌즈/뷰티 탭 전환
    - 렌즈 탭: 렌즈 선택 RecyclerView + 설정 슬라이더
    - 뷰티 탭: 뷰티 필터 슬라이더

    @version 2.0.0
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- GPU 렌더링 뷰 (GLSurfaceView 기반) -->
    <com.irislenssdk.demo.camera.gpu.CameraGLView
        android:id="@+id/cameraGLView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 디버그 오버레이 뷰 (Face Mesh, 홍채 마커, 디버그 정보) -->
    <com.irislenssdk.demo.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cameraGLView"
        app:layout_constraintBottom_toBottomOf="@id/cameraGLView"
        app:layout_constraintStart_toStartOf="@id/cameraGLView"
        app:layout_constraintEnd_toEndOf="@id/cameraGLView" />

    <!-- 상태 정보 오버레이 -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detect FPS: --"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Render FPS: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLensStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lens: 없음"
            android:textColor="@android:color/holo_blue_light"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 디버그 토글 버튼 -->
    <LinearLayout
        android:id="@+id/debugButtonPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnToggleMesh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mesh"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnToggleDebug"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Debug"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnToggleIris"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Iris"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- 컨트롤 패널 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF333333"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabTextColor="#CCCCCC"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabIndicatorColor="@color/purple_500"
            app:tabIndicatorFullWidth="false">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="렌즈" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뷰티" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 탭 콘텐츠 컨테이너 (고정 높이로 탭 전환 시 레이아웃 변경 방지) -->
        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- 렌즈 탭 콘텐츠 -->
            <LinearLayout
                android:id="@+id/lensTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="visible">

                <!-- 렌즈 선택 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLenses"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <!-- 렌즈 설정 슬라이더 -->
                <LinearLayout
                    android:id="@+id/lensSettingsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="visible">

                    <!-- Opacity 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="투명도"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensOpacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="40" />

                    </LinearLayout>

                    <!-- Scale 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="크기"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensScale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="45" />

                    </LinearLayout>

                    <!-- Edge Feather 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="경계"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensFeather"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="10" />

                    </LinearLayout>

                    <!-- 블렌드 모드 선택 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="블렌드"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <RadioGroup
                            android:id="@+id/rgBlendMode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbBlendNormal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Normal"
                                android:textColor="@android:color/white"
                                android:textSize="10sp"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/rbBlendMultiply"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Multiply"
                                android:textColor="@android:color/white"
                                android:textSize="10sp" />

                            <RadioButton
                                android:id="@+id/rbBlendScreen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Screen"
                                android:textColor="@android:color/white"
                                android:textSize="10sp" />

                            <RadioButton
                                android:id="@+id/rbBlendOverlay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Overlay"
                                android:textColor="@android:color/white"
                                android:textSize="10sp" />

                        </RadioGroup>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 뷰티 탭 콘텐츠 -->
            <ScrollView
                android:id="@+id/beautyTabContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 뷰티 토글 버튼 -->
                <Button
                    android:id="@+id/btnToggleBeauty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beauty: ON"
                    android:textAllCaps="false" />

                <!-- 프리셋 선택 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnPresetNatural"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Natural"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minWidth="0dp"
                        android:backgroundTint="#FF4CAF50"
                        style="@style/Widget.MaterialComponents.Button" />

                    <Button
                        android:id="@+id/btnPresetStudio"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Studio"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minWidth="0dp"
                        android:backgroundTint="#FF2196F3"
                        style="@style/Widget.MaterialComponents.Button" />

                    <Button
                        android:id="@+id/btnPresetGlamour"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Glamour"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minWidth="0dp"
                        android:backgroundTint="#FFE91E63"
                        style="@style/Widget.MaterialComponents.Button" />

                    <Button
                        android:id="@+id/btnPresetCustom"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Custom"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minWidth="0dp"
                        android:backgroundTint="#FF666666"
                        style="@style/Widget.MaterialComponents.Button" />

                </LinearLayout>

                <!-- Smoothing 슬라이더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="스무딩"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekSmoothing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50" />

                </LinearLayout>

                <!-- Brightness 슬라이더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="밝기"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekBrightness"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50" />

                </LinearLayout>

                <!-- Whitening 슬라이더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="화이트닝"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekWhitening"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0" />

                </LinearLayout>

                <!-- Color Balance 슬라이더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="컬러밸런스"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekColorBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50" />

                </LinearLayout>

                <!-- Soft Focus 슬라이더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="소프트포커스"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekSoftFocus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="30" />

                </LinearLayout>

                <!-- LUT 필터 구분선 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#44FFFFFF"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <!-- LUT 프리셋 라벨 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LUT Filter"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- LUT 프리셋 가로 스크롤 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/lutPresetRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnLutOff"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="OFF"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutRosyGlow"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Rosy"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutPeachCream"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Peach"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutCleanPorcelain"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Clean"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutGoldenHour"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Golden"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutFilmVintage"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Film"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutCoolEditorial"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Cool"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutWarmSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Warm"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:layout_marginEnd="4dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnLutNaturalGlow"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="64dp"
                            android:text="Natural"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#FF795548"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- LUT 강도 슬라이더 -->
                <LinearLayout
                    android:id="@+id/lutIntensityPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="LUT 강도"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekLutIntensity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100" />

                </LinearLayout>

              </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
