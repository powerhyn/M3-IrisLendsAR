<?xml version="1.0" encoding="utf-8"?>
<!--
    IrisLensSDK Android - GPU Render Activity Layout (v3.0)

    풀스크린 카메라 + 오버레이 바텀시트 UI:
    - 카메라/오버레이: match_parent 풀스크린
    - 하단 바텀시트(BottomSheetBehavior): peek=렌즈 썸네일 바(상시) → 확장 시 렌즈/뷰티 탭
    - 뷰티 기능(skin/radiance/slim/brightness)은 슬라이더로 통합
    - 개발/벤치 버튼은 기어(⚙) 토글로 접기

    @version 3.0.0
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- GPU 렌더링 뷰 (풀스크린) -->
    <com.irislenssdk.demo.camera.gpu.CameraGLView
        android:id="@+id/cameraGLView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 디버그 오버레이 뷰 (Face Mesh, 홍채 마커) — 카메라와 동일 풀스크린, COVER 매핑 -->
    <com.irislenssdk.demo.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상태 정보 오버레이 (좌상단) -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000">

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detect FPS: --"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Render FPS: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLensStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lens: 없음"
            android:textColor="@android:color/holo_blue_light"
            android:textSize="14sp" />

        <!-- ③-3 A/B HUD 1줄 — 추적 공급자/듀얼 측정 요약 -->
        <TextView
            android:id="@+id/tvAbHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRK:LEGACY"
            android:textColor="#FFFFB300"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 기어(⚙) 토글 버튼 (우상단, 항상 보임) — 개발/벤치 패널 표시/숨김 -->
    <ImageButton
        android:id="@+id/btnGearToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#80000000"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="개발자 패널 토글"
        app:tint="#FFFFFFFF" />

    <!-- 개발자/벤치 패널 컨테이너 (기본 GONE, 기어로 토글) -->
    <LinearLayout
        android:id="@+id/devPanelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 디버그 토글 버튼 -->
        <LinearLayout
            android:id="@+id/debugButtonPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#80000000">

            <Button
                android:id="@+id/btnToggleMesh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Mesh"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:backgroundTint="#66666666"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnToggleDebug"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Debug"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:backgroundTint="#66666666"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnToggleIris"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Iris"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:backgroundTint="#66666666"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnToggleLog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Log"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:backgroundTint="#66666666"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- EYECLIP: eyelidMask 경계 디버그 오버레이 토글 (ellipse vs Y-slab 형상 비교) -->
            <Button
                android:id="@+id/btnToggleMaskEdge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="MaskEdge"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:backgroundTint="#66666666"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <!-- B1/B8 4조합 블라인드 벤치 패널 (A/B/C/D) -->
        <LinearLayout
            android:id="@+id/lensBenchPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#80000000">

            <Button
                android:id="@+id/btnBenchA"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnBenchB"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnBenchC"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnBenchD"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <!-- 블링크 ramp(B5) / 저조도 gate(B9) / 디테일 재주입(C10) / 측정 luma(W7) 벤치 토글 -->
        <LinearLayout
            android:id="@+id/w6BenchPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#80000000">

            <Button
                android:id="@+id/btnW6Blink"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="up80"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnW6Gate"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="g.10"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnW6Detail"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:text="C10:on"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnW7Measured"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:text="lum:meas"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnW4Cap"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:text="cap:off"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnImgMode"
                android:layout_width="68dp"
                android:layout_height="36dp"
                android:text="img:off"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <!-- TASKS frame-sync 킬스위치 -->
        <LinearLayout
            android:id="@+id/p33AbPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#80000000">

            <Button
                android:id="@+id/btnFrameSync"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:text="fsync:off"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnStabFast"
                android:layout_width="104dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:text="stab:norm"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:backgroundTint="#66555555"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===================================================================
         바텀시트: peek=렌즈 썸네일 바(상시) → 확장 시 렌즈/뷰티 탭
         =================================================================== -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#66000000"
        app:behavior_peekHeight="160dp"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- 드래그 핸들 (확장/축소 그립 + 접근성) -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- PEEK 영역: 렌즈 썸네일 가로 바 (상시 노출) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLenses"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <!-- 확장 영역: 탭 (렌즈/뷰티) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF333333"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabTextColor="#CCCCCC"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabIndicatorColor="@color/purple_500"
            app:tabIndicatorFullWidth="false">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="렌즈" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뷰티" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 탭 콘텐츠 컨테이너 (고정 높이로 탭 전환 시 레이아웃 변경 방지) -->
        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- 렌즈 탭 콘텐츠 (rvLenses는 peek로 이동 → 세부 설정만) -->
            <ScrollView
                android:id="@+id/lensTabContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 렌즈 설정 슬라이더 -->
                <LinearLayout
                    android:id="@+id/lensSettingsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Opacity 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="투명도"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensOpacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="40" />

                    </LinearLayout>

                    <!-- Scale 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="크기"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensScale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="45" />

                    </LinearLayout>

                    <!-- Edge Feather 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="경계"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensFeather"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="10" />

                    </LinearLayout>

                    <!-- 블렌드 모드 선택 (7개: Spinner) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="블렌드"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerBlendMode"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="#44FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                    </LinearLayout>

                    <!-- Sclera / Shadow 토글 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnToggleSclera"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Sclera: ON"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#4400CC00" />

                        <Button
                            android:id="@+id/btnToggleShadow"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Shadow: OFF"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#44FF0000" />

                    </LinearLayout>

                    <!-- Ellipse 토글 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnToggleEllipse"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Mask: Y-slab"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#44FF0000" />

                    </LinearLayout>

                    <!-- 홍채 밝기 보정 (Color Replace maxDetail) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="밝기"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp" />

                        <SeekBar
                            android:id="@+id/seekMaxDetail"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            android:max="6"
                            android:progress="4" />

                        <TextView
                            android:id="@+id/tvMaxDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.2"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:minWidth="28dp"
                            android:gravity="end" />

                    </LinearLayout>

                </LinearLayout>

              </LinearLayout>
            </ScrollView>

            <!-- 뷰티 탭 콘텐츠 -->
            <ScrollView
                android:id="@+id/beautyTabContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 뷰티 마스터 토글 -->
                <Button
                    android:id="@+id/btnToggleBeauty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beauty: ON"
                    android:textAllCaps="false" />

                <!-- 턱슬림(slim) 슬라이더 (0~0.50) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="턱슬림"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekSlim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:max="50"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvSlimValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:minWidth="36dp"
                        android:gravity="end" />

                </LinearLayout>

                <!-- 피부(skin) 슬라이더 (0~1.0) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="피부"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekSkin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvSkinValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:minWidth="36dp"
                        android:gravity="end" />

                </LinearLayout>

                <!-- 화사함(radiance) 슬라이더 (0~0.60) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="화사함"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekRadiance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:max="60"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvRadianceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:minWidth="36dp"
                        android:gravity="end" />

                </LinearLayout>

              </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
