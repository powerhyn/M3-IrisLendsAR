<?xml version="1.0" encoding="utf-8"?>
<!--
    IrisLensSDK Android - GPU Render Activity Layout

    Tab 기반 UI: 렌즈/뷰티 탭 전환
    - 렌즈 탭: 렌즈 선택 RecyclerView + 설정 슬라이더
    - 뷰티 탭: 뷰티 필터 슬라이더

    @version 2.0.0
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- GPU 렌더링 뷰 (GLSurfaceView 기반) -->
    <com.irislenssdk.demo.camera.gpu.CameraGLView
        android:id="@+id/cameraGLView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 디버그 오버레이 뷰 (Face Mesh, 홍채 마커, 디버그 정보) -->
    <com.irislenssdk.demo.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cameraGLView"
        app:layout_constraintBottom_toBottomOf="@id/cameraGLView"
        app:layout_constraintStart_toStartOf="@id/cameraGLView"
        app:layout_constraintEnd_toEndOf="@id/cameraGLView" />

    <!-- 상태 정보 오버레이 -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detect FPS: --"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Render FPS: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGpuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: --"
            android:textColor="@android:color/holo_green_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLensStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lens: 없음"
            android:textColor="@android:color/holo_blue_light"
            android:textSize="14sp" />

        <!-- ③-3 A/B HUD 1줄 (REFACTOR-3-3 §4.2) — 추적 공급자/듀얼 측정 요약 -->
        <TextView
            android:id="@+id/tvAbHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRK:LEGACY"
            android:textColor="#FFFFB300"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 디버그 토글 버튼 -->
    <LinearLayout
        android:id="@+id/debugButtonPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnToggleMesh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mesh"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnToggleDebug"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Debug"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnToggleIris"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Iris"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnToggleLog"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Log"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:backgroundTint="#66666666"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- P6-W5 §5.9: B1/B8 4조합 블라인드 벤치 패널 (A/B/C/D) -->
    <LinearLayout
        android:id="@+id/lensBenchPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#80000000"
        app:layout_constraintTop_toBottomOf="@id/debugButtonPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBenchA"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:text="A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnBenchB"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:text="B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnBenchC"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:text="C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnBenchD"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- P6-W6: 블링크 ramp(B5) / 저조도 gate(B9) / 디테일 재주입(C10) 벤치 토글 패널 -->
    <LinearLayout
        android:id="@+id/w6BenchPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#80000000"
        app:layout_constraintTop_toBottomOf="@id/lensBenchPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnW6Blink"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:text="up80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnW6Gate"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:text="g.10"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnW6Detail"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:text="C10:on"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnW7Measured"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="lum:meas"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnP8Skin"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="skin:off"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnP8Radiance"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="rad:off"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- W4-D: TASKS 단일 경로 — frame-sync 킬스위치만 유지 (추적 공급자 토글/듀얼 A/B 측정 제거) -->
    <LinearLayout
        android:id="@+id/p33AbPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#80000000"
        app:layout_constraintTop_toBottomOf="@id/w6BenchPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnFrameSync"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:text="fsync:off"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:backgroundTint="#66555555"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- 컨트롤 패널 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF333333"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabTextColor="#CCCCCC"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabIndicatorColor="@color/purple_500"
            app:tabIndicatorFullWidth="false">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="렌즈" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뷰티" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 탭 콘텐츠 컨테이너 (고정 높이로 탭 전환 시 레이아웃 변경 방지) -->
        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- 렌즈 탭 콘텐츠 -->
            <ScrollView
                android:id="@+id/lensTabContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 렌즈 선택 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLenses"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <!-- 렌즈 설정 슬라이더 -->
                <LinearLayout
                    android:id="@+id/lensSettingsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="visible">

                    <!-- Opacity 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="투명도"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensOpacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="40" />

                    </LinearLayout>

                    <!-- Scale 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="크기"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensScale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="45" />

                    </LinearLayout>

                    <!-- Edge Feather 슬라이더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="경계"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekLensFeather"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="10" />

                    </LinearLayout>

                    <!-- 블렌드 모드 선택 (7개: Spinner) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="블렌드"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerBlendMode"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="#44FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                    </LinearLayout>

                    <!-- Sclera / Shadow 토글 (P4-W2-01) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnToggleSclera"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Sclera: ON"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#4400CC00" />

                        <Button
                            android:id="@+id/btnToggleShadow"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Shadow: OFF"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#44FF0000" />

                    </LinearLayout>

                    <!-- Ellipse 토글 (P5-W3). P7-W3: 3D Light 버튼 제거(폐기된 하이라이트). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnToggleEllipse"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Ellipse: OFF"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="#44FF0000" />

                    </LinearLayout>

                    <!-- 홍채 밝기 보정 (Color Replace maxDetail) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="밝기"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp" />

                        <SeekBar
                            android:id="@+id/seekMaxDetail"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            android:max="6"
                            android:progress="4" />

                        <TextView
                            android:id="@+id/tvMaxDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.2"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:minWidth="28dp"
                            android:gravity="end" />

                    </LinearLayout>

                </LinearLayout>

              </LinearLayout>
            </ScrollView>

            <!-- 뷰티 탭 콘텐츠 -->
            <ScrollView
                android:id="@+id/beautyTabContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 뷰티 토글 버튼 -->
                <Button
                    android:id="@+id/btnToggleBeauty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beauty: ON"
                    android:textAllCaps="false" />

                <!-- 코 보호 토글 -->
                <Button
                    android:id="@+id/btnProtectNose"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:text="코보호: OFF"
                    android:textSize="11sp"
                    android:textColor="#FFAAAAAA"
                    android:backgroundTint="#44444444" />

              </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
