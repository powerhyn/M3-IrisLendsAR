<?xml version="1.0" encoding="utf-8"?>
<!--
    MediaPipe SDK 벤치마크 액티비티 레이아웃

    MediaPipe Tasks Vision의 FaceLandmarker를 직접 사용하여
    IrisLensSDK(TFLite 기반)와 성능 비교를 위한 테스트 화면

    @version 1.0.0
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MediaPipeBenchmarkActivity">

    <!-- 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 모드 표시 배너 (MediaPipe 구분용) -->
    <TextView
        android:id="@+id/modeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF6B35"
        android:gravity="center"
        android:padding="8dp"
        android:text="🔶 MediaPipe SDK Mode 🔶"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 상단 정보 바 -->
    <LinearLayout
        android:id="@+id/topInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/modeBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 타이틀 및 뒤로가기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_button_bg"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Back"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="MediaPipe SDK (Direct API)"
                android:textColor="#FF6B35"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 상태 및 FPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- 상태 표시 텍스트 -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#80000000"
                android:padding="8dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:text="Initializing MediaPipe..." />

            <!-- FPS 표시 -->
            <TextView
                android:id="@+id/fpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#80000000"
                android:padding="8dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:text="FPS: --" />

        </LinearLayout>

    </LinearLayout>

    <!-- 하단 컨트롤 컨테이너 -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 정보 텍스트 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MediaPipe Tasks Vision FaceLandmarker를 직접 사용하여\nIrisLensSDK와 성능 비교를 수행합니다."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.2" />

        <!-- GPU 토글 및 벤치마크 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <!-- GPU 토글 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/gpuToggleButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="GPU: OFF"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <View
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- 벤치마크 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/benchmarkButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Start Benchmark"
                app:backgroundTint="#FF6B35" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
