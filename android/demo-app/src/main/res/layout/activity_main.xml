<?xml version="1.0" encoding="utf-8"?>
<!--
    IrisLensSDK Android - Demo App Main Layout

    메인 액티비티 레이아웃
    - CameraX PreviewView
    - 렌즈 선택 UI
    - 투명도/크기 조절 슬라이더
    - 캡처/카메라 전환 버튼

    @version 1.0.0
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- 모드 표시 배너 (IrisLensSDK 구분용) -->
    <TextView
        android:id="@+id/modeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_500"
        android:gravity="center"
        android:padding="6dp"
        android:text="🟣 IrisLensSDK (TFLite) Mode 🟣"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeBanner" />

    <!-- 렌즈 오버레이 뷰 (홍채 검출 결과 시각화) -->
    <com.irislenssdk.demo.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@id/cameraPreview"
        app:layout_constraintStart_toStartOf="@id/cameraPreview"
        app:layout_constraintTop_toTopOf="@id/cameraPreview" />

    <!-- 상단 정보 바 -->
    <LinearLayout
        android:id="@+id/topInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/modeBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 상태 표시 텍스트 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#80000000"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="Initializing..." />

        <!-- FPS 표시 -->
        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#80000000"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="FPS: --" />

        <!-- 설정 버튼 -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_button_bg"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="@string/btn_settings"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- 하단 컨트롤 컨테이너 -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 렌즈 선택 영역 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_select_lens"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 렌즈 선택 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lensRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp" />

        <!-- 슬라이더 영역 -->
        <LinearLayout
            android:id="@+id/slidersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="12dp">

            <!-- 투명도 슬라이더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_opacity"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/opacitySlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:value="0.8"
                    android:stepSize="0.05"
                    app:trackColorActive="@color/purple_500"
                    app:trackColorInactive="#40FFFFFF"
                    app:thumbColor="@color/purple_500" />

                <TextView
                    android:id="@+id/opacityValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 크기 슬라이더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_scale"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/scaleSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:value="1.0"
                    android:stepSize="0.05"
                    app:trackColorActive="@color/purple_500"
                    app:trackColorInactive="#40FFFFFF"
                    app:thumbColor="@color/purple_500" />

                <TextView
                    android:id="@+id/scaleValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 하단 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp">

            <!-- 카메라 전환 버튼 -->
            <ImageButton
                android:id="@+id/switchCameraButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="@string/btn_switch_camera"
                android:tint="@android:color/white" />

            <!-- 캡처 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="36dp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp" />

            <!-- 갤러리/저장 버튼 -->
            <ImageButton
                android:id="@+id/galleryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="@string/btn_gallery"
                android:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
